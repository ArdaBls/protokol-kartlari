{
  "rules": {
    "ilProtokolVerileri": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'editor' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "universiteProtokolVerileri": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'editor' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "etkinlikler": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'editor' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "basinGorevlileri": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "ayarlar": {
      "testModuAcik": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "test": {
      "ilProtokolVerileri": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'editor' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      },
      "universiteProtokolVerileri": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'editor' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      },
      "etkinlikler": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'editor' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      },
      "basinGorevlileri": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "logs": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$listKey": {
          "$logId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'editor' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['firstName','lastName','email','role'])",
        // Whitelist: role sadece 'pending'|'editor'|'admin' olabilir -- hem kendi kendine kayit
        // (pending) hem de admin tarafindan yapilan degisiklik icin AYNI whitelist kosulu gecerli.
        //
        // NOT ("son admin kalmasin" kisiti): Bu kisiti Rules seviyesinde ifade etmek pratik degil --
        // tum users dugumunu sayip "bu yazimdan sonra en az bir admin kaliyor mu" diye kontrol etmek
        // Rules dilinde kirilgan/pahali olur (iki admin ayni anda yazarsa yarisma durumu da olusabilir).
        // Bunun yerine index.html/setUserRole() icinde ISTEMCI TARAFINDA bir kontrol var: mevcut
        // admin sayisi sayilip, son admin ise rolu dusurme islemi reddediliyor. Bu, kotu niyetli/
        // dogrudan REST API cagrisina karsi TAM bir garanti DEGILDIR (sadece normal admin panel
        // akisini korur) -- tam garanti icin bir Cloud Function tetikleyicisi gerekir.
        "role": {
          ".validate": "(newData.val() === 'pending' || newData.val() === 'editor' || newData.val() === 'admin') && ((auth.uid === $uid && !data.exists() && newData.val() === 'pending') || (root.child('users').child(auth.uid).child('role').val() === 'admin'))"
        }
      }
    },
    "logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$listKey": {
        "$logId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'editor' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    }
  }
}
